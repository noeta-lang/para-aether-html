// The frame onion, driven with no browser and no socket — the counterpart to para/html's
// `liveview-events`, and for the same reason: a security layer whose only exercise is a live
// websocket is a security layer nobody tests.
//
//   noeta run onion_demo.noe
//
// `para.html.wake` builds a wake by hand and `onion(layers)` returns exactly the interceptor
// `handle_all` receives, so what runs here is the production path with a synthetic frame at the top
// rather than a socket.
use para.aether_html
use para.aether_html.{Frame, FrameMiddleware, FrameNext, LiveMount, RateLimit, Trace, onion}
use para.html
use para.html.{render, Html}
use std.reactive.signal

// A layer that records the order it saw a frame in, then continues — enough to prove the onion
// nests rather than merely iterating: an outer layer's *after* runs after every inner layer.
class Mark {
    label: string
    trail: Signal<string>

    pub fn new(label: string, trail: Signal<string>): Mark {
        return Mark { label: label, trail: trail }
    }

    impl FrameMiddleware {
        pub fn handle(f: Frame, next: FrameNext): void {
            self.trail.set("${self.trail.get()}>${self.label}")
            next.run(f)
            self.trail.set("${self.trail.get()}<${self.label}")
        }
    }
}

// A layer that refuses every client frame by never calling `next` — the shape every authorization
// layer bottoms out in.
class Deny {
    pub fn new(): Deny {
        return Deny {}
    }

    impl FrameMiddleware {
        pub fn handle(f: Frame, next: FrameNext): void {}
    }
}

// A layer that leaves a value for the layers inside it, proving the per-frame context threads.
class Stamp {
    pub fn new(): Stamp {
        return Stamp {}
    }

    impl FrameMiddleware {
        pub fn handle(f: Frame, next: FrameNext): void {
            f.set("who", "ada")
            next.run(f)
        }
    }
}

class ReadStamp {
    seen: Signal<string>

    pub fn new(seen: Signal<string>): ReadStamp {
        return ReadStamp { seen: seen }
    }

    impl FrameMiddleware {
        pub fn handle(f: Frame, next: FrameNext): void {
            self.seen.set(f.get("who", "<none>"))
            next.run(f)
        }
    }
}

// A page the mount tests can name. They never render it — a mount's routing decision is made before
// anything is rendered — so an empty template is the honest stand-in.
fn page_stub(): Html {
    return @html { <p>stub</p> }
}

// Run one synthetic frame through a stack, reporting whether the work at the bottom ran.
fn drive(layers: List<dyn FrameMiddleware>, name: string, tick: bool): bool {
    ran = signal(false)
    intercept = onion(layers)
    intercept(html.wake(name, "", tick), fn() => ran.set(true))
    return ran.get()
}

fn empty_stack(): void {
    // An onion with no layers must be indistinguishable from no interceptor at all — the property
    // that lets `serve` and para/html's plain `handle` be the same code path with a different stack.
    // If this ever diverges, every claim about "adopting this package changes nothing else" is false.
    echo drive([], "e0", false)
    echo drive([], "", true)
}

fn nesting(): void {
    trail = signal("")
    // Registration order is outside-in, exactly as aether's HTTP onion: the first layer sees the
    // frame first and finishes last.
    echo drive([Mark.new("a", trail), Mark.new("b", trail)], "e0", false)
    echo trail.get()
}

fn refusal(): void {
    // A layer that never calls `next` stops the work — and stops every layer inside it too.
    trail = signal("")
    echo drive([Deny.new(), Mark.new("inner", trail)], "e0", false)
    echo trail.get() == ""
    // Refusing is positional: the same `Deny` inside a `Mark` still lets the outer layer run.
    trail2 = signal("")
    echo drive([Mark.new("outer", trail2), Deny.new()], "e0", false)
    echo trail2.get()
}

fn context(): void {
    seen = signal("")
    echo drive([Stamp.new(), ReadStamp.new(seen)], "e0", false)
    echo seen.get()
    // The context is per FRAME, not per session: a second frame through the same stack starts empty.
    seen2 = signal("")
    echo drive([ReadStamp.new(seen2)], "e0", false)
    echo seen2.get()
}

fn rate_limiting(): void {
    // A budget of 2 per minute on one action: the third frame is dropped, and a DIFFERENT action is
    // untouched by the cap.
    limit = RateLimit.new("e0", 2, 60000)
    echo drive([limit], "e0", false)
    echo drive([limit], "e0", false)
    echo drive([limit], "e0", false)
    echo drive([limit], "e1", false)
    // A tick is never rate-limited: it has no client behind it.
    echo drive([limit], "", true)
}

fn tracing(): void {
    // `Trace` wraps the work rather than preceding it, so what it reports covers the frame's whole
    // cost — the handler, the keyed reconcile, and the diff push.
    said = signal("")
    echo drive([Trace.new(fn(m: string) => said.set(m))], "e7", false)
    echo said.get().starts_with("frame e7 took")
    said2 = signal("")
    echo drive([Trace.new(fn(m: string) => said2.set(m))], "", true)
    echo said2.get().starts_with("tick took")
}

fn main(): void {
    empty_stack()
    nesting()
    refusal()
    context()
    rate_limiting()
    tracing()
}

main()

// The onion is security machinery, so it is gated by `@test` and not only by the `echo` walkthrough
// above: CI runs `noeta check` + `noeta test`, never `noeta run`. Each test is self-contained —
// `noeta test` runs every test in a fresh isolate and never executes top-level statements.
@test {
    // The property that lets adopting this package be a no-op for everything except the layers you
    // asked for. If an empty onion ever diverged from no interceptor, every claim in the README about
    // `serve` being `handle` plus a stack would be false.
    fn an_empty_onion_is_indistinguishable_from_no_interceptor(): void {
        assert(drive([], "e0", false), "a client frame runs with no layers")
        assert(drive([], "", true), "a tick runs with no layers")
    }

    // Registration order is outside-in, matching aether's HTTP onion, and layers NEST — an outer
    // layer's after-phase runs after every inner layer, which is what makes `Trace` able to measure
    // the whole frame.
    fn layers_nest_outside_in(): void {
        trail = signal("")
        assert(drive([Mark.new("a", trail), Mark.new("b", trail)], "e0", false))
        assert(trail.get() == ">a>b<b<a", trail.get())
    }

    // Not calling `next` is how a layer refuses: the work never happens, and neither does any layer
    // inside it.
    fn a_layer_that_never_calls_next_stops_the_work_and_everything_inside_it(): void {
        trail = signal("")
        assert(!drive([Deny.new(), Mark.new("inner", trail)], "e0", false))
        assert(trail.get() == "", "a layer inside a refusing one must never run")
    }

    // Refusal is positional: an outer layer still completes both phases around an inner refusal.
    fn an_outer_layer_still_runs_around_an_inner_refusal(): void {
        trail = signal("")
        assert(!drive([Mark.new("outer", trail), Deny.new()], "e0", false))
        assert(trail.get() == ">outer<outer", trail.get())
    }

    // Context threads outward-in, and is scoped to ONE frame — a cache that could outlive the wake
    // that filled it would have to be invalidated, and nothing on this path could notice.
    fn frame_context_threads_inward_and_does_not_outlive_the_frame(): void {
        seen = signal("")
        assert(drive([Stamp.new(), ReadStamp.new(seen)], "e0", false))
        assert(seen.get() == "ada", seen.get())
        fresh = signal("")
        assert(drive([ReadStamp.new(fresh)], "e0", false))
        assert(fresh.get() == "<none>", "a second frame must start with an empty context")
    }

    // The per-action budget drops what is over it, leaves other actions alone, and never touches a
    // tick.
    fn a_rate_limit_caps_only_its_own_action(): void {
        limit = RateLimit.new("e0", 2, 60000)
        assert(drive([limit], "e0", false), "first frame is in budget")
        assert(drive([limit], "e0", false), "second frame is in budget")
        assert(!drive([limit], "e0", false), "third frame is over budget")
        assert(drive([limit], "e1", false), "a different action is untouched by the cap")
        assert(drive([limit], "", true), "a tick is never rate-limited")
    }

    // A mount answers exactly its own three URLs and falls through for everything else. The
    // middleware itself needs a live request, so what is asserted here is the DECISION — which is the
    // part with a rule in it — and it delegates to para/html's `serves`, so this test fails if that
    // package ever changes what a mount owns.
    fn a_mount_claims_exactly_its_own_urls(): void {
        m = LiveMount.new("/todos", "Todos", page_stub, [])
        assert(m.claims("/todos"), "the page itself")
        assert(m.claims("/todos/ws"), "its socket")
        assert(m.claims("/todos/live.js"), "its shim")
        assert(!m.claims("/"), "a mount must not claim the root")
        assert(!m.claims("/api/users"), "a mount must not claim a sibling route")
        assert(!m.claims("/chat/ws"), "a mount must not claim another mount's socket")
    }

    // Two mounts in one app must not shadow each other, including when one prefix is a string-prefix
    // of the other.
    fn two_mounts_in_one_app_do_not_overlap(): void {
        todos = LiveMount.new("/todos", "Todos", page_stub, [])
        to = LiveMount.new("/to", "To", page_stub, [])
        assert(!to.claims("/todos"), "prefix matching must be segment-exact, not substring")
        assert(!todos.claims("/to"))
        assert(to.claims("/to/ws") && !todos.claims("/to/ws"))
    }

    // `Trace` wraps rather than precedes, so what it reports is the frame's real cost.
    fn trace_reports_every_wake_including_ticks(): void {
        said = signal("")
        assert(drive([Trace.new(fn(m: string) => said.set(m))], "e7", false))
        assert(said.get().starts_with("frame e7 took"), said.get())
        ticked = signal("")
        assert(drive([Trace.new(fn(m: string) => ticked.set(m))], "", true))
        assert(ticked.get().starts_with("tick took"), ticked.get())
    }
}
